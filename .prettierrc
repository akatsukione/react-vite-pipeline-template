{
  "trailingComma": "es5",
  "tabWidth":4,
  "semi": true,
  "singleQuote": true,
  "endOfLine": "auto",
  "printWidth": 150,
  "htmlWhitespaceSensitivity": "ignore",
  "overrides": [
    {
      "files": "*.tsx",
      "options": {
        "tabWidth": 2,
        "useTabs": true
      }
    },
    {
      "files": "*.md",
      "options": {
        "proseWrap": "always"
      }
    }
  ]
}